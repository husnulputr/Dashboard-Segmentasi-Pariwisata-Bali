# ==========================================
# 4. SERVER LOGIC
# ==========================================
server <- function(input, output, session) {
  
  # Reactive Data (Sama seperti sebelumnya)
  processed_data <- reactive({
    df <- clean_data
    if(input$filter_city != "All") df <- df %>% filter(city == input$filter_city)
    if(input$filter_cat != "All") df <- df %>% filter(categoryName == input$filter_cat)
    df <- df %>% filter(totalScore >= input$filter_rating[1], totalScore <= input$filter_rating[2])
    
    df_scale <- df %>% select(Skor_Kenyamanan, Skor_Popularitas) %>% scale()
    hc_res <- hclust(dist(df_scale), method = input$linkage_method)
    df$Cluster <- as.factor(cutree(hc_res, k = input$k_cluster))
    
    list(data = df, hc = hc_res, scale = df_scale)
  })

  # Render Plots (Sama seperti sebelumnya namun dengan penyesuaian warna)
  output$plot_top_dest <- renderPlotly({
    p <- processed_data()$data %>% arrange(desc(reviewsCount)) %>% head(10) %>%
      ggplot(aes(x = reorder(title, reviewsCount), y = reviewsCount, fill = Cluster)) +
      geom_col(width = 0.7) + coord_flip() + theme_minimal() +
      scale_fill_brewer(palette = "Set2") + labs(x="", y="")
    ggplotly(p)
  })

  output$plot_pie_cluster <- renderPlotly({
    df_pie <- processed_data()$data %>% count(Cluster)
    plot_ly(df_pie, labels = ~Cluster, values = ~n, type = 'pie', hole = 0.6) %>%
      layout(showlegend = FALSE, margin = list(t=0, b=0, l=0, r=0))
  })

  output$plot_cluster_pca <- renderPlot({
    fviz_cluster(list(data = processed_data()$scale, cluster = processed_data()$data$Cluster),
                 palette = "Set2", geom = "point", ellipse.type = "convex", ggtheme = theme_minimal())
  })
  
  output$plot_dendro <- renderPlot({
    fviz_dend(processed_data()$hc, k = input$k_cluster, k_colors = "Set2", rect = TRUE, main = "")
  })

  output$plot_scatter <- renderPlotly({
    p <- ggplot(processed_data()$data, aes(x = reviewsCount, y = totalScore, color = Cluster, text = title)) +
      geom_point(alpha = 0.6, size = 3) + scale_x_log10() + theme_minimal()
    ggplotly(p, tooltip = "text")
  })

  output$box_total_dest <- renderValueBox({
    valueBox(nrow(processed_data()$data), "Destinations", icon = icon("map"), color = "primary")
  })
  
  output$box_avg_rating <- renderValueBox({
    valueBox(round(mean(processed_data()$data$totalScore), 2), "Avg Rating", icon = icon("star"), color = "warning")
  })
  
  output$box_total_rev <- renderValueBox({
    valueBox(format(sum(processed_data()$data$reviewsCount), big.mark=","), "Reviews", icon = icon("users"), color = "info")
  })

  output$table_raw <- renderDT({
    datatable(processed_data()$data %>% select(title, city, totalScore, Cluster), options = list(pageLength = 7))
  })

  output$insight_box <- renderUI({
    df <- processed_data()$data
    summary_cluster <- df %>% group_by(Cluster) %>% summarise(avg_pop = mean(reviewsCount))
    top_pop_cluster <- summary_cluster$Cluster[which.max(summary_cluster$avg_pop)]
    
    fluidRow(
      infoBox("Top Cluster", paste("Cluster", top_pop_cluster), icon = icon("fire"), color = "danger", width = 6, fill = TRUE),
      infoBox("Data Status", "Live Updated", icon = icon("check-circle"), color = "success", width = 6, fill = TRUE)
    )
  })
}

shinyApp(ui, server)
